# MINHA PLANTINHA - PRODUÇÃO VERCEL & SUPABASE
# Variáveis de ambiente para deploy na Vercel

# Supabase Client (Chaves públicas seguras expostas ao client no Vite / Next.js)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Previsão Meteorológica (Open-Meteo é aberta e gratuita, dispensando chaves de API pagas)
# https://open-meteo.com/en/docs

# Google Gemini AI (Variável de servidor / Vercel Serverless Function - NUNCA expor no frontend)
GEMINI_API_KEY=

# Vercel Production Environment
NODE_ENV=production
